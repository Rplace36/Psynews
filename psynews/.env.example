# ── Supabase (required) ──────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase server-side (for Vercel serverless functions only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here   # NEVER expose in client code

# ── Resend email (optional — enables welcome emails)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=hello@yourdomain.com

# ── OpenAI (optional — enables AI writing assistant)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Analytics (optional)
VITE_PLAUSIBLE_DOMAIN=psynews.vercel.app   # your Plausible domain

# ── Site URL (used in emails and sitemap)
SITE_URL=https://psynews.vercel.app
